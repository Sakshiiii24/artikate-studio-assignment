# Django environment settings
DEBUG=True
SECRET_KEY=django-insecure-development-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# PostgreSQL database settings
# For Docker Compose stack use host 'db': postgresql://postgres:postgres@db:5432/artikate_db
# For local host execution against forwarded port: postgresql://postgres:postgres@localhost:5432/artikate_db
DATABASE_URL=postgresql://postgres:postgres@db:5432/artikate_db
POSTGRES_DB=artikate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis & Celery broker settings
# For Docker Compose stack use host 'redis': redis://redis:6379/0
# For local host execution: redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
